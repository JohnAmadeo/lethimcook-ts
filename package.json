{
  "name": "lethimcook",
  "version": "0.1.0",
  "description": "A library for unit conversions, especially for cooking",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./converter": {
      "import": "./dist/converter.js",
      "types": "./dist/converter.d.ts"
    },
    "./natural": {
      "import": "./dist/natural.js",
      "types": "./dist/natural.d.ts"
    },
    "./recipe": {
      "import": "./dist/recipe.js",
      "types": "./dist/recipe.d.ts"
    },
    "./units": {
      "import": "./dist/units.js",
      "types": "./dist/units.d.ts"
    }
  },
  "bin": {
    "lethimcook": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
