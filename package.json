{
  "name": "lethimcook",
  "version": "0.1.0",
  "description": "A TypeScript library for unit conversions, especially for cooking",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "lethimcook": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --passWithNoTests",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cooking",
    "unit-conversion",
    "recipes",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
