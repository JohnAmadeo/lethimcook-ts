{
  "name": "lethimcook",
  "version": "0.1.0",
  "description": "A Node.js library for unit conversions, especially for cooking",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./converter": {
      "import": "./dist/converter.js",
      "types": "./dist/converter.d.ts"
    },
    "./recipe": {
      "import": "./dist/recipe.js",
      "types": "./dist/recipe.d.ts"
    },
    "./units": {
      "import": "./dist/units.js",
      "types": "./dist/units.d.ts"
    },
    "./natural": {
      "import": "./dist/natural.js",
      "types": "./dist/natural.d.ts"
    }
  },
  "bin": {
    "lethimcook": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "dev": "tsc --watch",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "cooking",
    "units",
    "conversion",
    "recipes"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "zod": "^3.22.0"
  }
}
